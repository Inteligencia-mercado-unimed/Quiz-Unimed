# ====================================================================
# SUPABASE CONFIGURATION (Obtidos no painel do Supabase -> Project Settings -> API)
# ====================================================================
# URL do seu projeto no Supabase
SUPABASE_URL="https://[SEU-PROJETO].supabase.co"

# Chave secreta de serviço (Service Role Secret) - Permite salvar tentativas e respostas com segurança no backend
SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Chave pública anon (Publishable Key)
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# URL do JWKS do Supabase (para validação de tokens JWT)
SUPABASE_JWKS_URL="https://[SEU-PROJETO].supabase.co/auth/v1/.well-known/jwks.json"

# ====================================================================
# SUPABASE POSTGRESQL / PRISMA DIRECT CONNECTION (Opcional se usar a API REST)
# ====================================================================
# 1. DATABASE_URL (Transaction Pooler - Porta 6543):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL (Direct Connection - Porta 5432):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ====================================================================
# DEMAIS CONFIGURAÇÕES DA APLICAÇÃO
# ====================================================================
# Administrador inicial autorizado (já configurado por padrão como rrochapablo@gmail.com)
ADMIN_DEFAULT_EMAIL="rrochapablo@gmail.com"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

